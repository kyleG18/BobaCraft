{
  "info": {
    "_postman_id": "bobacraft-api-lab-2026-finals",
    "name": "BobaCraft Milk Tea Bar — API Laboratory (Performance, Reliability & Monitoring)",
    "description": "Comprehensive Postman test collection for the BobaCraft Milk Tea Bar API Laboratory.\nCovers:\n1. Performance Optimization (Indexed + Paginated vs Full Table Scan)\n2. Predictable JSON Error Handling (400, 401, 403, 404, 422, 429)\n3. Input Validation (Form Requests with field-level details)\n4. Caching & Cache Invalidation (X-Cache: HIT / MISS)\n5. Rate Limiting (Strict 5 req/min demonstration)\n6. Diagnostic Request Logging (X-Request-ID, X-Response-Time-Ms, X-DB-Queries)\n7. Security & API Key RBAC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "admin_api_key",
      "value": "bobacraft-admin-key-2026",
      "type": "string"
    },
    {
      "key": "kiosk_api_key",
      "value": "bobacraft-customer-key-2026",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Performance & Benchmark",
      "item": [
        {
          "name": "GET Live Benchmark Telemetry (Side-by-Side)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/benchmark",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "benchmark"]
            },
            "description": "Executes simultaneous baseline vs optimized queries against 10,000+ records and returns exact execution times, memory usage, and payload sizes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Benchmark contains comparison\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.laboratory_benchmark).to.have.property('comparison');",
                  "    pm.expect(json.laboratory_benchmark.comparison.optimized.execution_time_ms).to.be.below(json.laboratory_benchmark.comparison.original.execution_time_ms);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Orders (Optimized Mode - Paginated & Indexed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders?mode=optimized&per_page=25&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "mode", "value": "optimized" },
                { "key": "per_page", "value": "25" },
                { "key": "page", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Optimization mode is optimized\", function () {",
                  "    pm.expect(pm.response.headers.get('X-Optimization-Mode')).to.eql('optimized');",
                  "    pm.expect(pm.response.headers.get('X-Records-Returned')).to.eql('25');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Orders (Original Baseline Mode - Full Table Scan)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders?mode=original",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "mode", "value": "original" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Optimization mode is original\", function () {",
                  "    pm.expect(pm.response.headers.get('X-Optimization-Mode')).to.eql('original');",
                  "    pm.expect(parseInt(pm.response.headers.get('X-Records-Returned'))).to.be.above(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Caching & Invalidation",
      "item": [
        {
          "name": "GET Order Statistics (Read-Heavy Cache)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "stats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Contains X-Cache Header\", function () {",
                  "    pm.expect(pm.response.headers.has('X-Cache')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST Create Order (Triggers Cache Invalidation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Professor Demonstration\",\n  \"drink\": \"Brown Sugar Pearl Milk Tea\",\n  \"size\": \"Large\",\n  \"sugar_level\": \"50%\",\n  \"ice_level\": \"Less Ice\",\n  \"toppings\": [\"Extra Pearls\", \"Cheese Foam\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Cache invalidated in meta\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.meta.cache_invalidated).to.include('bobacraft_order_stats');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Input Validation & Error Handling (422 / 404)",
      "item": [
        {
          "name": "POST Order (Invalid Payload - 422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"\",\n  \"size\": \"SuperSize\",\n  \"sugar_level\": \"150%\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 422 Unprocessable\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"Standard predictable error schema returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.error.code).to.eql('VALIDATION_FAILED');",
                  "    pm.expect(json.error).to.have.property('details');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Order (Non-Existent ID - 404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/9999999",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "9999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Standard predictable error schema returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.error.code).to.eql('RESOURCE_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Authentication & Authorization (401 / 403)",
      "item": [
        {
          "name": "GET Admin Verify (Valid Admin Key - 200)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{admin_api_key}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "verify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Admin authenticated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Admin Verify (Missing Key - 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "verify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Error code is UNAUTHORIZED\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Admin Verify (Kiosk Key - 403 Forbidden)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{kiosk_api_key}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "verify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 403 Forbidden\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"Error code is FORBIDDEN\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error.code).to.eql('FORBIDDEN');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Rate Limiting (429)",
      "item": [
        {
          "name": "GET Rate Limit Test (Trigger 429)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/rate-limit-test",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "rate-limit-test"]
            },
            "description": "Send 6 consecutive requests. On the 6th call within 1 minute, the API responds with 429 Too Many Requests and Retry-After header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "    pm.test(\"HTTP 429 Rate Limit returned\", function () { pm.expect(pm.response.code).to.eql(429); });",
                  "    pm.test(\"Retry-After header present\", function () { pm.expect(pm.response.headers.has('Retry-After')).to.be.true; });",
                  "    pm.test(\"Predictable error schema returned\", function () {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.error.code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "    });",
                  "} else {",
                  "    pm.test(\"Status is 200 within quota\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Diagnostic Request Logging",
      "item": [
        {
          "name": "GET Orders (Inspect Diagnostics & X-Request-ID)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Request-ID", "value": "demo-prof-eval-req-1234" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders?per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "per_page", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Diagnostic headers returned\", function () {",
                  "    pm.expect(pm.response.headers.has('X-Request-ID')).to.be.true;",
                  "    pm.expect(pm.response.headers.has('X-Response-Time-Ms')).to.be.true;",
                  "    pm.expect(pm.response.headers.has('X-Memory-Peak-MB')).to.be.true;",
                  "    pm.expect(pm.response.headers.has('X-DB-Queries')).to.be.true;",
                  "});",
                  "pm.test(\"Reflects custom X-Request-ID if provided\", function () {",
                  "    pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('demo-prof-eval-req-1234');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
